# Public values only. Everything here ends up in the browser bundle.
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_NEAR_RPC_URL=https://rpc.testnet.fastnear.com
NEXT_PUBLIC_VAULT_ID=vault.cpdemo.testnet
NEXT_PUBLIC_TOKEN_ID=cpusd.cpdemo.testnet
NEXT_PUBLIC_DAO_ID=checkpoint-council.sputnik-v2.testnet
NEXT_PUBLIC_AGENTS_URL=http://localhost:8788
NEXT_PUBLIC_GUARD_URL=http://localhost:8787
NEXT_PUBLIC_EXPLORER_URL=https://testnet.nearblocks.io
# 1: the agents pipeline runs in the browser (same parser, rules and Coordinator as the service) over the
#    frozen snapshot, with a stand-in wallet. Use it for a deploy with no agents service behind it.
# 0: talk to the agents service at NEXT_PUBLIC_AGENTS_URL. For a keyless local run, start it with
#    `MOCK_AUTO_APPROVE_MS=0 pnpm mock` (real service, fake chain); the web app detects it and
#    offers its stand-in wallet instead of a real approval.
NEXT_PUBLIC_USE_MOCK=1
