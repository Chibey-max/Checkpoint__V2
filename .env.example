# Checkpoint configuration (PRD §11.7). Copy to .env and fill in. Never commit .env.
# Public values only in this file. Secrets go in .env and the team password manager.

NEAR_NETWORK=testnet                 # testnet | sandbox (mainnet is rejected, NFR-02)
NEAR_RPC_URL=                        # chosen on Day 0 (D-04), e.g. https://rpc.testnet.fastnear.com
VAULT_ID=vault.cpdemo.testnet
TOKEN_ID=cpusd.cpdemo.testnet
DAO_ID=checkpoint-council.sputnik-v2.testnet
GUARD_URL=http://localhost:8787
GUARD_SECRET_KEY=                    # ed25519 seed, base58; never commit. Generate: pnpm guard keygen
GUARD_KEY_VERSION=1
AGENT_ACCOUNT_ID=agent.cpdemo.testnet
AGENT_FC_PRIVATE_KEY=                # ed25519:… function-call key only
LLM_PROVIDER=groq                    # groq | none (none = deterministic parser + template text)
GROQ_API_KEY=                        # gsk_…; never commit. https://console.groq.com/keys
LLM_MODEL=openai/gpt-oss-120b        # Groq production model with strict structured outputs
LLM_REASONING_EFFORT=low             # low | medium | high (gpt-oss models only)
EVIDENCE_DIR=./data/snapshot

# Additional service settings (defaults shown; all optional)
GUARD_PORT=8787
AGENTS_PORT=8788
AGENTS_DB_PATH=./data/private/agents.sqlite
RULES_CONFIG_PATH=./config/rules.config.json
WEB_ORIGIN=http://localhost:3000        # comma-separated; one * per entry for Vercel previews, e.g. https://x.vercel.app,https://x-*-team.vercel.app
GUARD_DEV=0                          # 1 = skip the startup rules-hash check (never on testnet)
GUARD_VAULT=rpc                      # rpc | mock (mock = in-memory Vault views for local dev)
AGENTS_CHAIN=rpc                     # rpc | mock (mock = auto-approve and fake payouts for local dev)

# Web app mirrors of the public values only
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_NEAR_RPC_URL=
NEXT_PUBLIC_VAULT_ID=vault.cpdemo.testnet
NEXT_PUBLIC_TOKEN_ID=cpusd.cpdemo.testnet
NEXT_PUBLIC_AGENTS_URL=http://localhost:8788

# NEAR Intents dry quotes (D-6.2, P2). Display-only, mainnet, dry: nothing moves.
AGENTS_INTENTS=on                    # on | off
ONECLICK_URL=                        # default https://1click.chaindefuser.com
ONECLICK_API_KEY=                    # optional; dry quotes worked without one on 7 Nov 2026
